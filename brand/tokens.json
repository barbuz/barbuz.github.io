{
  "meta": {
    "name": "barbuz brand tokens",
    "version": "0.1.0",
    "source": "brand/tokens.json",
    "css": "brand/tokens.css",
    "js": "brand/tokens.js",
    "docs": "docs/DESIGN-NOTES.md",
    "note": "Edit this file, then run `npm run tokens`. Never edit tokens.css or tokens.js by hand.",
    "rules": [
      "Cool at night, warm by day. Blue is the one colour that crosses both.",
      "Mono type is the shared thread: it is the same on both faces."
    ]
  },
  "personas": {
    "barbuz": {
      "scheme": "dark",
      "color": {
        "page-bg": "#0a0e17",
        "bg": "#0a0e17",
        "surface": "#111726",
        "surface-2": "#161d2e",
        "text": "#e7eaf2",
        "muted": "#8a94aa",
        "line": "#232c40",
        "accent": "#3d7bff",
        "accent-ink": "#06090f",
        "accent-soft": "rgba(61, 123, 255, 0.28)",
        "success": "#22c55e",
        "warning": "#f0b429",
        "danger": "#f87171"
      },
      "chrome": {
        "text": "#e7eaf2",
        "line": "#232c40",
        "accent": "#3d7bff",
        "accent-ink": "#06090f",
        "surface": "rgba(17, 23, 38, 0.72)"
      },
      "shadow": {
        "base": "0 24px 60px rgba(0, 0, 0, 0.55)",
        "accent": "0 10px 30px rgba(61, 123, 255, 0.34)"
      },
      "font": {
        "display": "'Bricolage Grotesque', system-ui, sans-serif",
        "body": "'Bricolage Grotesque', system-ui, sans-serif",
        "display-weight": "800"
      }
    },
    "leo": {
      "scheme": "light",
      "color": {
        "page-bg": "#faf8f3",
        "bg": "#faf8f3",
        "surface": "#ffffff",
        "surface-2": "#f5f2ea",
        "text": "#1b1a17",
        "muted": "#6e6a5f",
        "line": "#e6dfd1",
        "accent": "#1d4ed8",
        "accent-ink": "#ffffff",
        "accent-soft": "rgba(29, 78, 216, 0.28)",
        "success": "#15803d",
        "warning": "#8a5a00",
        "danger": "#b91c1c"
      },
      "chrome": {
        "text": "#1b1a17",
        "line": "#e6dfd1",
        "accent": "#1d4ed8",
        "accent-ink": "#ffffff",
        "surface": "rgba(255, 255, 255, 0.72)"
      },
      "shadow": {
        "base": "0 18px 44px rgba(70, 58, 34, 0.12)",
        "accent": "0 12px 30px rgba(29, 78, 216, 0.24)"
      },
      "font": {
        "display": "'Instrument Serif', Georgia, serif",
        "body": "'Instrument Sans', system-ui, sans-serif",
        "display-weight": "400"
      }
    }
  },
  "shared": {
    "font": {
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "motion": {
      "dur": "0.9s",
      "dur-fast": "0.2s",
      "dur-base": "0.25s",
      "dur-slow": "0.3s",
      "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "radius": {
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.1rem",
      "pill": "999px"
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    }
  }
}

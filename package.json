		"autoprefixer": "^10.4.20",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-svelte": "^0.562.0",
		"maplibre-gl": "^5.15.0",
